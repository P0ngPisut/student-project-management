# Copy to backend/.env only when it does not exist. Fill passwords locally.
# Runtime authenticates as project_app and pins the test DB in auth_store.py.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_PASSWORD=

# Local administrator configuration for reviewed installers/rollback tests.
# API runtime does NOT use these credentials as an application fallback.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# Legacy connector only; current runtime/tools pin the test DB independently.
DB_NAME=student_project_management_v1_test
